    {
      "type": "bargauge",
      "id": 9,
      "title": "Error budget remaining (30 d)",
      "description": "1 − (bad ratio ÷ allowed bad ratio). 100% = untouched, 0% = budget exhausted, below 0% = SLO breached.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp_min(1 - (1 - (sum(increase(blokus_app_actions_success_total[30d])) / sum(increase(blokus_app_actions_total[30d])))) / 0.01, 0)",
          "legendFormat": "SLI-1 App Availability",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp_min(1 - (1 - (sum(increase(blokus_join_duration_ms_bucket{le=\"1000\"}[30d])) / sum(increase(blokus_join_duration_ms_count[30d])))) / 0.05, 0)",
          "legendFormat": "SLI-2 Join Speed",
          "refId": "B",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
